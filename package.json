{
  "name": "gharsync-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "export:ios": "expo export --platform ios --output-dir /tmp/gharsync-ios",
    "export:android": "expo export --platform android --output-dir /tmp/gharsync-android"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "expo": "~57.0.25",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.24",
    "expo-document-picker": "~57.0.2",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.0"
  }
}
