diff --git a/apps/api/src/auth/mobile-auth.controller.ts b/apps/api/src/auth/mobile-auth.controller.ts
new file mode 100644
index 0000000..869448e
--- /dev/null
+++ b/apps/api/src/auth/mobile-auth.controller.ts
@@ -0,0 +1,60 @@
+import { Body, Controller, Get, HttpCode, Param, Post, Req } from "@nestjs/common";
+import { Throttle } from "@nestjs/throttler";
+import type { Request } from "express";
+import { z } from "zod";
+import { signInSchema, signUpSchema } from "@gharsync/validation";
+import { CurrentAuth, Public, type AuthContext } from "./auth-context.js";
+import { AuthService } from "./auth.service.js";
+
+function requestInfo(request: Request) {
+  const userAgent = request.headers["user-agent"];
+  return { ip: request.ip, userAgent: Array.isArray(userAgent) ? userAgent[0] : userAgent };
+}
+
+@Controller("mobile")
+export class MobileAuthController {
+  constructor(private readonly auth: AuthService) {}
+
+  @Public()
+  @Throttle({ auth: { limit: 8, ttl: 60_000 } })
+  @Post("sign-in")
+  @HttpCode(200)
+  async signIn(@Body({ schema: signInSchema }) body: z.infer<typeof signInSchema>, @Req() request: Request) {
+    const result = await this.auth.signIn(body.email, body.password, requestInfo(request), "gharsync-mobile");
+    return { ...result.tokens, user: result.user, phoneVerificationRequired: result.phoneVerificationRequired };
+  }
+
+  @Public()
+  @Throttle({ auth: { limit: 5, ttl: 60_000 } })
+  @Post("register")
+  async register(@Body({ schema: signUpSchema }) body: z.infer<typeof signUpSchema>, @Req() request: Request) {
+    const result = await this.auth.register(body, requestInfo(request), "gharsync-mobile");
+    return { ...result.tokens, user: result.user, phoneVerificationRequired: result.phoneVerificationRequired };
+  }
+
+  @Public()
+  @Throttle({ auth: { limit: 10, ttl: 60_000 } })
+  @Post("refresh")
+  @HttpCode(200)
+  refresh(@Body() body: { refreshToken?: string }) {
+    return this.auth.refresh(body.refreshToken ?? "", "gharsync-mobile-refresh");
+  }
+
+  @Public()
+  @Post("sign-out")
+  @HttpCode(200)
+  signOut(@Body() body: { refreshToken?: string }, @Req() request: Request) {
+    return this.auth.signOut(body.refreshToken, requestInfo(request));
+  }
+
+  @Get("me")
+  me(@CurrentAuth() current: AuthContext) {
+    return this.auth.getMe(current.userId, current.organizationId);
+  }
+
+  @Post("organizations/:organizationId/select")
+  @HttpCode(200)
+  selectOrganization(@CurrentAuth() current: AuthContext, @Param("organizationId", { schema: z.uuid() }) organizationId: string) {
+    return this.auth.selectOrganization(current, organizationId);
+  }
+}
