{
  "name": "gharsync-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "export:ios": "expo export --platform ios --output-dir /tmp/gharsync-ios",
    "export:android": "expo export --platform android --output-dir /tmp/gharsync-android",
    "seed:demo-accounts": "node scripts/seed-simple-demo-accounts.mjs",
    "seed:demo-data": "node scripts/seed-demo-module-data.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "expo": "^58.0.0",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "libphonenumber-js": "^1.13.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.0"
  }
}
